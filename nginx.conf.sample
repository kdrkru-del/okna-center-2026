# Nginx server configuration snippet for Okna Center (SEO 301 Redirects)
server {
    listen 80;
    listen 443 ssl http2;
    server_name xn--80aknmcbtp7a.xn--p1ai www.xn--80aknmcbtp7a.xn--p1ai;

    root /var/www/okna_center/out;
    index index.html;

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # 301 Permanent Redirects for Legacy URLs & 404 links
    rewrite ^/remont_plastikovyh_okon_vladivostok_2/?$ /remont_plastikovyh_okon_vladivostok/ permanent;
    rewrite ^/osteklenie_balkona/?$ /osteklenie_balkona_vladivostok/ permanent;
    rewrite ^/okna/?$ /kupit_plastikovye_okna_vladivostok/ permanent;
    rewrite ^/balkon_pod_klyuch_vladivostok/?$ /osteklenie_balkona_vladivostok/ permanent;
    rewrite ^/lodzhii/?$ /lodgia_pod_klyuch_vladivostok/ permanent;
    rewrite ^/osteklenie_lodgiy_vladivostok/?$ /lodgia_pod_klyuch_vladivostok/ permanent;
    rewrite ^/plastikovie_okna_vo_vladivostoke/?$ /kupit_plastikovye_okna_vladivostok/ permanent;
    rewrite ^/plastikovie_okna_vo_vladivostoke_2_2/?$ /kupit_plastikovye_okna_vladivostok/ permanent;
    rewrite ^/stienovyie_panieli_mdf/?$ /otdielochnyie_matierialy/ permanent;
    rewrite ^/undefined/?$ / permanent;

    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    # Cache static assets
    location ~* \.(?:ico|css|js|gif|jpe?g|png|webp|svg|woff2?)$ {
        expires 6M;
        access_log off;
        add_header Cache-Control "public, max-age=15552000, immutable";
    }
}
